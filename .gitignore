# Local QBench credentials and environment overrides
.env
.env.*
!.env.example
*.secret
*.secrets
secrets.local.*
qbench_sandbox_token*

# Local publisher audit output (may contain Sandbox object identifiers)
QBench/Worksheets/Terpenes/development/*/audit/

# Raw Sandbox worksheet proof exports (preserved locally; sanitized evidence is tracked)
QBench/Worksheets/Terpenes/development/*/sandbox_destination_proof/*saved_reopened_export_spreadsheet.json
QBench/Worksheets/Terpenes/development/*/sandbox_destination_proof/*instantiated_export_spreadsheet.csv
QBench/Worksheets/Terpenes/development/*/sandbox_destination_proof/*object_ids.local.json

# Raw Sandbox native Test Worksheet probe exports (preserved locally; sanitized evidence is tracked)
QBench/Worksheets/Terpenes/development/*/native_test_worksheet_probe/*saved_reopened_export_spreadsheet.json
QBench/Worksheets/Terpenes/development/*/native_test_worksheet_probe/*instantiated_export_spreadsheet.*
QBench/Worksheets/Terpenes/development/*/native_test_worksheet_probe/*object_ids.local.json

# Raw Sandbox native 43-field rebuild exports (preserved locally; sanitized evidence is tracked)
QBench/Worksheets/Terpenes/development/*/native_43_field_rebuild/*saved_reopened_export_spreadsheet.json
QBench/Worksheets/Terpenes/development/*/native_43_field_rebuild/*instantiated_export_spreadsheet.*
QBench/Worksheets/Terpenes/development/*/native_43_field_rebuild/*object_ids.local.json

# Raw Sandbox JSON-scalar runtime export (preserved locally; sanitized evidence is tracked)
QBench/Worksheets/Terpenes/development/*/json_import_rebuild/runtime_instantiation/SBX_ONLY_TERPENES_2026_07_17_JSON_SCALAR_RUNTIME_TEST_WORKSHEET_export_data.csv

