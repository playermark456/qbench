      "total_terpenes_unit": "%",
      "automatic_export_enabled": true,
      "warnings_requiring_confirmation": []
    },
    "additional_infused": {
      "template_sheet": "Additional-Terpenes (mg_g)",
      "matrix_scope": "Infused Products",
