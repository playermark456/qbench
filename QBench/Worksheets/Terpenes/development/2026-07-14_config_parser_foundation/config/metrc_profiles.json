        "",
        "N/A"
      ],
      "include_formula_depends_on_column": false
    }
  },
  "include_formula_policy": {
    "depends_on": [
      "configured_profile",
      "configured_mapping",
      "numeric_result_present"
    ],
    "does_not_depend_on": [
      "schema_outcome_column"
    ]
  },
  "profiles": {
    "additional_raw_concentrate": {
      "template_sheet": "Additional-Terpenes (%)",
